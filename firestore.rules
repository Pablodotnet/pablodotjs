rules_version = '2';

// Reglas para la app de Lista de Deseos Familiar.
// - El acceso está limitado por "códigos familiares": cada quien puede
//   pertenecer a varias familias (familyCodes[]) y sólo ve a los familiares y
//   las listas de quienes comparten AL MENOS UNO de sus códigos.
// - Cada quien edita/borra sus deseos.
// - El estado "comprado" vive en /compras (doc id = id del deseo): lo marca
//   otro familiar, es anónimo, y el DUEÑO del deseo no puede leerlo (para no
//   saber qué le compraron de su propia lista).
service cloud.firestore {
  match /databases/{database}/documents {

    // Familias (códigos) del usuario que hace la petición.
    function misFamilias() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('familyCodes', []);
    }

    // Consultar el perfil actual evita que una lista siga compartida al salir.
    // Compartimos familia si nuestros códigos se intersectan con los del otro.
    function comparteFamilia(uid) {
      return misFamilias().size() > 0
             && get(/databases/$(database)/documents/users/$(uid)).data.get('familyCodes', []).hasAny(misFamilias());
    }

    // Perfiles de los familiares.
    match /users/{uid} {
      // Puedo leer mi propio perfil siempre, y el de quienes comparten alguna familia.
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || (misFamilias().size() > 0
                          && resource.data.get('familyCodes', []).hasAny(misFamilias())));
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Deseos de la lista.
    match /wishes/{wishId} {
      // Puedo leer mis propios deseos, y los de quienes comparten alguna familia.
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.ownerUid
                      || comparteFamilia(resource.data.ownerUid));
      // Un deseo es mío y lo ven todas mis familias; no se etiqueta con una sola.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid
                    && misFamilias().size() > 0
                    && request.resource.data.keys().hasOnly([
                      'ownerUid', 'ownerName', 'titulo', 'url',
                      'tienda', 'precio', 'nota', 'imagen', 'createdAt'
                    ]);
      // Sólo el dueño edita su deseo. El estado "comprado" NO se guarda aquí.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['titulo', 'url', 'tienda', 'precio', 'nota', 'imagen']);
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;
    }

    // Estado "comprado" de cada deseo (doc id = id del deseo).
    // El DUEÑO del deseo NO puede leer esto: así nunca sabe qué le compraron.
    // Sólo otro familiar que comparta alguna familia puede marcarlo, y es
    // anónimo (no se guarda quién compró) e irreversible.
    match /compras/{wishId} {
      allow read: if request.auth != null
                  && request.auth.uid != resource.data.ownerUid
                  && comparteFamilia(resource.data.ownerUid);
      allow create: if request.auth != null
                    && request.auth.uid != request.resource.data.ownerUid
                    && comparteFamilia(request.resource.data.ownerUid)
                    && get(/databases/$(database)/documents/wishes/$(wishId)).data.ownerUid
                       == request.resource.data.ownerUid
                    && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt']);
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------
    // Price Tracker: cada quien ve y administra sólo sus propios productos.
    // El rastreador de precios corre con el Admin SDK (service account), que
    // ignora estas reglas; por eso el cliente nunca escribe el historial.
    // -------------------------------------------------------------------
    match /products/{productId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.ownerUid;

      // Historial de precios: lo escribe únicamente el rastreador (Admin SDK).
      // El cliente sólo puede leer el historial de sus propios productos.
      match /historial/{entryId} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/products/$(productId)).data.ownerUid == request.auth.uid;
        allow write: if false;
      }
    }
  }
}
