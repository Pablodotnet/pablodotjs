rules_version = '2';

// Reglas para la app de Lista de Deseos Familiar.
// - El acceso está limitado por "código familiar": cada quien sólo ve a los
//   familiares y las listas que comparten su mismo familyCode.
// - Cada quien edita/borra lo suyo; otros familiares pueden marcarlo comprado.
// - comprado es un booleano opcional (ausente equivale a false).
//   No se guarda la identidad de quien compra.
service cloud.firestore {
  match /databases/{database}/documents {

    // Código familiar del usuario que hace la petición.
    function miFamilia() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('familyCode', '');
    }

    // Consultar el perfil actual evita que una lista siga compartida al salir.
    // familyCode en los deseos antiguos no determina la pertenencia actual.
    function comparteFamilia(uid) {
      return miFamilia() != ''
             && get(/databases/$(database)/documents/users/$(uid)).data.get('familyCode', '') == miFamilia();
    }

    // Perfiles de los familiares.
    match /users/{uid} {
      // Puedo leer mi propio perfil siempre, y el de quienes comparten mi familyCode.
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || (miFamilia() != '' && resource.data.get('familyCode', '') == miFamilia()));
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Deseos de la lista.
    match /wishes/{wishId} {
      // Puedo leer mis propios deseos, y los de mi misma familia.
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.ownerUid
                      || comparteFamilia(resource.data.ownerUid));
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid
                    && miFamilia() != ''
                    && request.resource.data.familyCode == miFamilia()
                    && request.resource.data.keys().hasOnly([
                      'ownerUid', 'ownerName', 'familyCode', 'titulo', 'url',
                      'tienda', 'precio', 'nota', 'createdAt', 'comprado'
                    ])
                    && request.resource.data.get('comprado', false) == false;
      allow update: if request.auth != null
                    && (
                      (request.auth.uid == resource.data.ownerUid
                       && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['titulo', 'url', 'tienda', 'precio', 'nota']))
                      || (request.auth.uid != resource.data.ownerUid
                          && comparteFamilia(resource.data.ownerUid)
                          && resource.data.get('comprado', false) == false
                          && request.resource.data.comprado == true
                          && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['comprado']))
                    );
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;
    }

    // -------------------------------------------------------------------
    // Price Tracker: cada quien ve y administra sólo sus propios productos.
    // El rastreador de precios corre con el Admin SDK (service account), que
    // ignora estas reglas; por eso el cliente nunca escribe el historial.
    // -------------------------------------------------------------------
    match /products/{productId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.ownerUid;

      // Historial de precios: lo escribe únicamente el rastreador (Admin SDK).
      // El cliente sólo puede leer el historial de sus propios productos.
      match /historial/{entryId} {
        allow read: if request.auth != null
                    && get(/databases/$(database)/documents/products/$(productId)).data.ownerUid == request.auth.uid;
        allow write: if false;
      }
    }
  }
}
